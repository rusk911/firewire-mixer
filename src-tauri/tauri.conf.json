{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FireMix",
  "version": "0.1.0",
  "identifier": "org.firemix.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev </dev/null 2>&1 | cat",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": []
  },
  "bundle": {
    "icon": ["icons/icon.png"]
  }
}